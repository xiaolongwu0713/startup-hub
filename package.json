{
  "name": "startup-hub",
  "version": "1.0.0",
  "description": "Startup idea collaboration platform",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev": "echo 'Use WeChat Developer Tools to run miniprogram'",
    "build": "echo 'Use WeChat Developer Tools to build miniprogram'"
  },
  "keywords": [
    "wechat",
    "miniprogram",
    "startup",
    "collaboration"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^29.0.0",
    "@types/node": "^18.0.0",
    "jest": "^29.0.0",
    "typescript": "^4.9.5"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "miniprogram/**/*.{js,ts}",
      "cloudfunctions/**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**"
    ]
  }
}
